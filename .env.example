# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.development

# Database
DB_NAME=news_portal
DB_USER=news_portal_user
DB_PASSWORD=news_portal_pass
DB_HOST=localhost
DB_PORT=5432

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Para testar entrega real fora do Docker (sem editar settings), suba o
# Mailpit isolado — `docker compose -f docker/docker-compose.yml up mailpit` —
# e aponte para ele descomentando as linhas abaixo. UI de inspeção em
# http://localhost:8025; dentro do Docker o host já vem configurado (ver
# docker/docker-compose.yml, serviço `web`), então isto é só para rodar o
# Django direto na máquina.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=localhost
# EMAIL_PORT=1025
# EMAIL_USE_TLS=False

# Login com Google (opcional). Sem as duas primeiras variáveis, o botão
# "Entrar com Google" nem aparece e as rotas devolvem 404 — o login por senha
# continua funcionando normalmente. Crie a credencial em
# console.cloud.google.com -> "ID do cliente OAuth" -> "Aplicativo da Web" e
# registre lá EXATAMENTE o mesmo redirect URI de baixo.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/accounts/google/callback/

# Códigos de confirmação de e-mail e recuperação de senha (opcional).
# VERIFICATION_CODE_TTL=600
# VERIFICATION_CODE_MAX_ATTEMPTS=5
